# Anthropic API-Key fuer das Claude-Scoring. Nie echte Keys committen.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Modell fuer das Scoring ueberschreiben (Standard: claude-opus-5)
# QUANTCODE_MODEL=claude-sonnet-5

# Optional, aber empfohlen: Alpha-Vantage-Key als Fallback, falls Yahoo
# Finance die Anfrage blockt (haeufig auf Server-/Cloud-IPs). Kostenloser
# Key: https://www.alphavantage.co/support/#api-key (25 Requests/Tag).
ALPHA_VANTAGE_API_KEY=

# Pexels API-Key fuer Stock-Footage im Reel-Generator
PEXELS_API_KEY=

# ElevenLabs API-Key fuer Voiceover-Generierung
ELEVENLABS_API_KEY=

# Instagram Graph API - fuer automatisiertes Posten (Reels, Carousels, Stories)
# IG_ACCESS_TOKEN: langlebiger Access Token aus dem Graph API Explorer
# IG_BUSINESS_ACCOUNT_ID: Instagram Business Account ID (nicht der Username)
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
